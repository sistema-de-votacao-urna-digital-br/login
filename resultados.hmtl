<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados e Apuração - Sistema de Votação</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-blue: #3b82f6;
            --accent-green: #22c55e;
            --accent-yellow: #eab308;
            --accent-orange: #f97316;
            --accent-red: #ef4444;
            --border-color: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            padding: 2rem;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
        }

        h1 {
            font-size: 1.8rem;
            color: var(--text-main);
        }

        .btn-voltar {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-voltar:hover {
            background-color: var(--border-color);
            color: var(--text-main);
        }

        /* Grade de Votações Finalizadas */
        .grid-votacoes {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
        }

        .card-votacao {
            background-color: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, opacity 0.5s ease, max-height 0.5s ease;
            max-height: 500px;
            overflow: hidden;
        }

        .card-votacao.apagando {
            opacity: 0;
            max-height: 0;
            padding-top: 0;
            padding-bottom: 0;
            margin-bottom: 0;
            border: none;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 600;
        }

        /* Status Badge e Cores do Semáforo */
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .status-1 { background-color: rgba(34, 197, 94, 0.15); color: var(--accent-green); border: 1px solid var(--accent-green); }
        .status-2, .status-3 { background-color: rgba(234, 179, 8, 0.15); color: var(--accent-yellow); border: 1px solid var(--accent-yellow); }
        .status-4 { background-color: rgba(249, 115, 22, 0.15); color: var(--accent-orange); border: 1px solid var(--accent-orange); }
        .status-5 { background-color: rgba(239, 68, 68, 0.15); color: var(--accent-red); border: 1px solid var(--accent-red); }

        .status-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            line-height: 1.4;
        }

        .card-actions {
            display: flex;
            gap: 0.75rem;
        }

        .btn-acao {
            flex: 1;
            padding: 0.6rem;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: opacity 0.2s;
        }

        .btn-ver {
            background-color: var(--accent-blue);
            color: white;
        }

        .btn-excluir {
            background-color: transparent;
            border: 1px solid var(--accent-red);
            color: var(--accent-red);
        }

        .btn-acao:hover {
            opacity: 0.85;
        }

        /* Modais */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(15, 23, 42, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            display: none;
        }

        .modal-content {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 2rem;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .modal-content h3 {
            margin-bottom: 1rem;
            color: var(--text-main);
        }

        .modal-content p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        .modal-input {
            width: 100%;
            padding: 0.75rem;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-main);
            margin-bottom: 1.5rem;
            font-size: 1rem;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        .btn-modal-cancel {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-modal-confirm {
            background-color: var(--accent-red);
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <header>
        <button class="btn-voltar" onclick="history.back()">← Voltar</button>
        <h1>Votações Concluídas</h1>
        <div></div>
    </header>

    <main class="grid-votacoes" id="gridVotacoes">
        <!-- Exemplo de Card 1: Tipo 1 (Verde) -->
        <div class="card-votacao" id="vota-1">
            <div>
                <div class="card-header">
                    <span class="card-title">Eleição Grêmio Estudantil</span>
                    <span class="status-badge status-1">Tipo 1</span>
                </div>
                <p class="status-desc">Um candidato ultrapassou a marca de 50% dos votos válidos!</p>
            </div>
            <div class="card-actions">
                <button class="btn-acao btn-ver" onclick="abrirConfiguracao('Eleição Grêmio Estudantil')">Ver</button>
                <button class="btn-acao btn-excluir" onclick="iniciarExclusao('vota-1', 'Eleição Grêmio Estudantil')">Excluir</button>
            </div>
        </div>

        <!-- Exemplo de Card 2: Tipo 5 (Vermelho) -->
        <div class="card-votacao" id="vota-2">
            <div>
                <div class="card-header">
                    <span class="card-title">Escolha do Orador</span>
                    <span class="status-badge status-5">Tipo 5</span>
                </div>
                <p class="status-desc">Os votos brancos e nulos somados em porcentagem ultrapassaram o candidato mais votado. Necessidade imperativa de refazer!</p>
            </div>
            <div class="card-actions">
                <button class="btn-acao btn-ver" onclick="abrirConfiguracao('Escolha do Orador')">Ver</button>
                <button class="btn-acao btn-excluir" onclick="iniciarExclusao('vota-2', 'Escolha do Orador')">Excluir</button>
            </div>
        </div>
    </main>

    <!-- Modal de Exclusão (Estilo Minecraft) -->
    <div class="modal-overlay" id="modalExclusao">
        <div class="modal-content">
            <h3 style="color: var(--accent-red);">Apagar Votação Permanentemente</h3>
            <p>Tem certeza que quer apagar essa votação? A votação será apagada, essa ação não poderá ser desfeita e será apagada para sempre.</p>
            <p id="instrucaoExclusao" style="font-weight: 600; color: var(--text-main);"></p>
            
            <input type="text" id="inputConfirmacao" class="modal-input" placeholder="Digite exatamente o texto solicitado..." onpaste="return false" oncopy="return false" oncut="return false">
            
            <div class="modal-actions">
                <button class="btn-modal-cancel" onclick="fecharModalExclusao()">Cancelar</button>
                <button class="btn-modal-confirm" id="btnConfirmarExclusao" onclick="executarExclusao()" disabled style="opacity: 0.5;">Apagar para Sempre</button>
            </div>
        </div>
    </div>

    <script>
        let cardAlvoId = null;
        let textoExigido = "";

        function iniciarExclusao(cardId, nomeVotacao) {
            cardAlvoId = cardId;
            textoExigido = `Excluir "${nomeVotacao}."`;
            
            document.getElementById('instrucaoExclusao').innerText = `Para confirmar a exclusão desta votação, digite exatamente isto no campo abaixo: ${textoExigido}`;
            document.getElementById('inputConfirmacao').value = "";
            document.getElementById('btnConfirmarExclusao').disabled = true;
            document.getElementById('btnConfirmarExclusao').style.opacity = "0.5";
            
            document.getElementById('modalExclusao').style.display = 'flex';
        }

        function fecharModalExclusao() {
            document.getElementById('modalExclusao').style.display = 'none';
        }

        const inputEl = document.getElementById('inputConfirmacao');
        inputEl.addEventListener('input', function() {
            // Trim nos espaços iniciais e finais conforme especificado no código
            const valorDigitado = this.value.trim();
            const btnConfirmar = document.getElementById('btnConfirmarExclusao');

            if (valorDigitado === textoExigido) {
                btnConfirmar.disabled = false;
                btnConfirmar.style.opacity = "1";
            } else {
                btnConfirmar.disabled = true;
                btnConfirmar.style.opacity = "0.5";
            }
        });

        function executarExclusao() {
            fecharModalExclusao();
            if (cardAlvoId) {
                const card = document.getElementById(cardAlvoId);
                // Efeito visual estilo aplicativo de celular (permanece 2 segundos, depois recolhe)
                setTimeout(() => {
                    card.classList.add('apagando');
                    setTimeout(() => {
                        card.remove();
                    }, 500); // Tempo da transição CSS do collapse
                }, 2000);
            }
        }

        function abrirConfiguracao(nome) {
            alert(`Abrindo configuração e chave mestra para: ${nome}`);
        }
    </script>
</body>
</html>
