<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados e Apuração - Sistema de Votação</title>
    <link rel="stylesheet" href="resultados.css">
</head>
<body>

    <header>
        <button class="btn-voltar" onclick="history.back()">← Voltar</button>
        <h1>Votações Concluídas</h1>
        <div></div>
    </header>

    <main class="grid-votacoes" id="gridVotacoes">
        <!-- Exemplo de Card 1: Tipo 1 (Verde) -->
        <div class="card-votacao" id="vota-1">
            <div>
                <div class="card-header">
                    <span class="card-title">Eleição Grêmio Estudantil</span>
                    <span class="status-badge status-1">Tipo 1</span>
                </div>
                <p class="status-desc">Um candidato ultrapassou a marca de 50% dos votos válidos!</p>
            </div>
            <div class="card-actions">
                <button class="btn-acao btn-ver" onclick="abrirConfiguracao('Eleição Grêmio Estudantil')">Ver</button>
                <button class="btn-acao btn-excluir" onclick="iniciarExclusao('vota-1', 'Eleição Grêmio Estudantil')">Excluir</button>
            </div>
        </div>

        <!-- Exemplo de Card 2: Tipo 5 (Vermelho) -->
        <div class="card-votacao" id="vota-2">
            <div>
                <div class="card-header">
                    <span class="card-title">Escolha do Orador</span>
                    <span class="status-badge status-5">Tipo 5</span>
                </div>
                <p class="status-desc">Os votos brancos e nulos somados em porcentagem ultrapassaram o candidato mais votado. Necessidade imperativa de refazer!</p>
            </div>
            <div class="card-actions">
                <button class="btn-acao btn-ver" onclick="abrirConfiguracao('Escolha do Orador')">Ver</button>
                <button class="btn-acao btn-excluir" onclick="iniciarExclusao('vota-2', 'Escolha do Orador')">Excluir</button>
            </div>
        </div>
    </main>

    <!-- Modal de Exclusão -->
    <div class="modal-overlay" id="modalExclusao">
        <div class="modal-content">
            <h3 style="color: var(--accent-red);">Apagar Votação Permanentemente</h3>
            <p>Tem certeza que quer apagar essa votação? A votação será apagada, essa ação não poderá ser desfeita e será apagada para sempre.</p>
            <p id="instrucaoExclusao" style="font-weight: 600; color: var(--text-main);"></p>
            
            <input type="text" id="inputConfirmacao" class="modal-input" placeholder="Digite exatamente o texto solicitado..." onpaste="return false" oncopy="return false" oncut="return false">
            
            <div class="modal-actions">
                <button class="btn-modal-cancel" onclick="fecharModalExclusao()">Cancelar</button>
                <button class="btn-modal-confirm" id="btnConfirmarExclusao" onclick="executarExclusao()" disabled style="opacity: 0.5;">Apagar para Sempre</button>
            </div>
        </div>
    </div>

    <script src="resultados.js"></script>
</body>
</html>
